#!/usr/bin/env bash
source "$HOME/.config/sketchybar/colors.sh"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

sketchybar --bar height=34 position=top padding_left=10 padding_right=10 color=$BAR

sketchybar --default icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
                     label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                     icon.color=$FG label.color=$FG \
                     padding_left=5 padding_right=5 \
                     background.corner_radius=6 background.height=24

for sid in $(seq 1 9); do
  sketchybar --add item space.$sid left \
             --set space.$sid icon="$sid" label.drawing=off drawing=off \
                   click_script="aerospace workspace $sid"
done

# Timer-Item: zeichnet jede Sekunde alle Spaces neu
sketchybar --add item space_observer left \
           --set space_observer drawing=off update_freq=1 \
                 script="$PLUGIN_DIR/aerospace.sh"

# Rechts: Uhr, WLAN, Batterie
sketchybar --add item clock right \
           --set clock update_freq=10 icon=" " icon.color=$ACCENT \
                 script="$PLUGIN_DIR/clock.sh" \
           --add item wifi right \
           --set wifi update_freq=30 script="$PLUGIN_DIR/wifi.sh" \
           --add item battery right \
           --set battery update_freq=60 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery power_source_change

sketchybar --update
