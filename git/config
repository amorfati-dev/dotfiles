# Public preferences. Personal identity lives in ~/.gitconfig.local.
[init]
    defaultBranch = main
[core]
    pager = delta
    excludesFile = ~/.config/git/ignore
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
[pull]
    rebase = true
[include]
    path = ~/.gitconfig.local
